# Gemini model: a 3.x Flash id. Check Vertex AI Model Garden for the current id.
# gemini-2.5 retires 2026-10-16; use a 3.x Flash id here.
GEMINI_MODEL=gemini-3.1-flash-lite

# GCP project and region
GOOGLE_CLOUD_PROJECT=hold-2026
# Vertex location for Gemini: the 3.x line serves from global on this project (Cloud Run region is separate)
GOOGLE_CLOUD_LOCATION=global

# Routes google-genai to Vertex AI instead of the Gemini Developer API (the library reads this, our code never does)
GOOGLE_GENAI_USE_ENTERPRISE=true

# Confluent Kafka (stored in Secret Manager; never committed)
CONFLUENT_BOOTSTRAP=
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=

# Set to 1 to use in-process bus and golden fixtures instead of real Gemini / Confluent calls
HOLD_FAKE_EXTERNALS=0

# CP-SAT time limit per API solve, seconds (api/hold/jobs.py)
HOLD_SOLVE_TIME_LIMIT_S=60

# The deployed origin, added to CORS (set by deploy.yml on Cloud Run; empty locally)
HOLD_ORIGIN=

# The deployed URL, read by the network-marked tests and the uptime workflow (a repository variable there)
HOLD_URL=https://hold-fwmdq7fc3q-uc.a.run.app
