{
  "name": "hold-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "icons": "node scripts/make_icons.mjs",
    "icons:check": "node scripts/make_icons.mjs --check",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons:native": "npx @capacitor/assets generate --ios --android",
    "build:native": "VITE_API_BASE=https://hold-fwmdq7fc3q-uc.a.run.app npm run build && npx cap sync && npm run check:native",
    "check:native": "node scripts/check_native_bundle.mjs"
  },
